#!/usr/bin/env python3
"""Block commits that contain credential-shaped strings.

Written after a live ESPN session cookie sat hardcoded in
scripts/test_espn_connection.py (2026-09-01). It was never committed, but only
because nobody ran `git add scripts/` that day -- and broad `git add` calls were
routine. The gitignore rules cover .env files; they do nothing about a secret
pasted into a .py.

Scans STAGED CONTENT ONLY, so it costs nothing on an ordinary commit and cannot
be fooled by an unstaged working copy. Exits non-zero to abort.

Install:  bash scripts/hooks/install.sh
Bypass:   git commit --no-verify      (for a deliberate false positive)
"""
import re
import subprocess
import sys

# Deliberately anchored on ASSIGNMENT to a long literal rather than "any long
# string". A bare base64 blob matches data files, model artifacts and lockfiles;
# `SECRET = "..."` almost never matches anything innocent.
PATTERNS = [
    (re.compile(r'ESPN_S2\s*[:=]\s*["\'][^"\']{20,}', re.I), "ESPN_S2 session cookie"),
    (re.compile(r'SWID\s*[:=]\s*["\']\{?[0-9A-F-]{30,}', re.I), "ESPN SWID account id"),
    (re.compile(r'-----BEGIN [A-Z ]*PRIVATE KEY-----'), "private key"),
    (re.compile(r'\bAKIA[0-9A-Z]{16}\b'), "AWS access key id"),
    (re.compile(r'\bgh[pousr]_[A-Za-z0-9]{30,}\b'), "GitHub token"),
    (re.compile(r'\bxox[abposr]-[A-Za-z0-9-]{10,}\b'), "Slack token"),
    (re.compile(
        r'(?:api[_-]?key|apikey|secret|password|passwd|auth[_-]?token|access[_-]?token)'
        r'\s*[:=]\s*["\'][A-Za-z0-9/+=_%\-\.]{16,}["\']', re.I),
     "hardcoded secret assignment"),
    # The exact shape of the 2026-09-01 incident: reading an env var but
    # supplying the real value as the fallback. Reading from the environment is
    # NOT evidence of safety, which is why this cannot live in the allowlist.
    # Two conditions, either sufficient: the VARIABLE is named like a secret,
    # or the VALUE looks like one (long, mixed case, digits). Matching every
    # long default flagged `environ.get("WALK_FORWARD_OUT", "walk-forward-...")`
    # -- a file path. A hook that cries wolf gets bypassed, so it has to
    # discriminate.
    (re.compile(r'(?:environ\.get|getenv)\s*\(\s*'
                r'["\'][A-Z_]*(?:S2|SWID|KEY|TOKEN|SECRET|PASSWORD|PASSWD|AUTH'
                r'|COOKIE|CRED|SESSION)[A-Z_]*["\']\s*,\s*["\'][^"\']{8,}["\']', re.I),
     "hardcoded fallback for a secret-named environment variable"),
    (re.compile(r'(?:environ\.get|getenv)\s*\(\s*["\'][^"\']+["\']\s*,\s*'
                r'["\'](?=[^"\']*[A-Z])(?=[^"\']*[a-z])(?=[^"\']*\d)'
                r'[A-Za-z0-9/+=_%\-{}\.]{24,}["\']'),
     "hardcoded high-entropy fallback for an environment variable"),
]

# Values that look like secrets but are not. Kept explicit and short: a long
# allowlist is how these hooks stop catching anything.
# NOTE: reading from os.environ / getenv is deliberately NOT allowlisted. The
# incident this hook exists for was `os.environ.get("ESPN_S2", "<real cookie>")`
# -- a line that reads the environment and hardcodes the secret anyway. An
# earlier version skipped any line mentioning os.environ and therefore missed
# the one case it was written to catch.
ALLOW = re.compile(
    r'(\.\.\.|<[A-Z_]+>|xxx+|your[_-]?|example|placeholder|dummy|redacted|changeme'
    r'|["\']\s*["\'])',                                 # empty literal
    re.I)


def staged_files():
    out = subprocess.run(["git", "diff", "--cached", "--name-only",
                          "--diff-filter=ACM"],
                         capture_output=True, text=True).stdout
    return [f for f in out.splitlines() if f.strip()]


def staged_added_lines(path):
    """Only ADDED lines -- pre-existing content is not this commit's problem."""
    out = subprocess.run(["git", "diff", "--cached", "-U0", "--", path],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            yield line[1:]


def main():
    findings = []
    for path in staged_files():
        if path.startswith("scripts/hooks/"):
            continue                      # this file describes the patterns
        for line in staged_added_lines(path):
            if ALLOW.search(line):
                continue
            for pat, label in PATTERNS:
                if pat.search(line):
                    shown = line.strip()
                    if len(shown) > 88:
                        shown = shown[:60] + " ... " + shown[-12:]
                    findings.append((path, label, shown))
                    break

    if not findings:
        return 0

    print("\n\033[31mCommit blocked: credential-shaped content in staged changes\033[0m\n")
    for path, label, line in findings:
        print(f"  {path}")
        print(f"    {label}: {line}\n")
    print("Move the value into an environment variable, or if this is a false")
    print("positive, commit with --no-verify.\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
