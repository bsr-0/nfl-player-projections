# Environment and secrets – never commit
.env
.env.local
.env.*.local
# .env.local and .env.*.local were covered, but .env.espn / .env.prod matched
# nothing. Any .env variant is a secrets file; ignore the whole family.
.env.*
*.env
!.env.example
secrets.py
*credentials*.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Data – only large/binary/generated files stay ignored; everything else
# under data/ (JSON, CSVs, small parquet outputs) is tracked in main.
scripts/data/cache/
*.db
*.db-shm
*.db-wal
*.db.bak*
*.joblib
*.pkl
*.pickle
# Timestamped pipeline snapshot parquets (bronze/silver/gold) — ~3.4GB,
# regenerate locally rather than version.
/data/artifacts/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
*.local

# IDE and OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temp
*.log
logs/
tmp/
temp/
.cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# Config bytecode (if present)
config/__pycache__/

.claude/settings.local.json

# Walk-forward validation artifact (generated, uploaded as workflow artifact)
walk-forward-validation.md

# Experiment outputs — regenerable from scripts/ and src/models/single_week_ppr/.
# These are large (60MB+ of row-level prediction dumps) and churn on every run,
# so they are kept on disk but out of the repo.
data/experiments/*.csv
data/experiments/*.weekskips.json

# EXCEPT the two Phase 4 row-level dumps: season_simulation.py reads them as
# its residual donor pool (residual_csv_paths default), so they are INPUTS to
# Phase 9, not outputs. Untracking them would break a fresh clone.
!data/experiments/phase4_row_level_predictions_v2_corrected.csv
!data/experiments/phase4_row_level_predictions_v2_corrected_2020_2022.csv

# experiment_log.jsonl is a small provenance log, not a CSV output — keep it.

# Superseded / aborted experiment runs, 2026-08. Kept on disk for provenance
# but not in git: phase7_coldstart_histnan is the 2026-08-25 arm, superseded
# twice (pre-datafix AND pre-component-mode-fix); phase7_histnan_v2 aborted on
# a strata bug after one season. Neither is comparable to anything current.
# The runs that ARE cited by GAPS.md are committed.
data/experiments/phase7_coldstart_histnan/
data/experiments/phase7_histnan_v2_20260827/
data/experiments/backups/
data/experiments/phase7_histnan_v3_20260827/joined_all.csv

# Model-artifact snapshots taken before a risky retrain (217-258MB each).
# Rollback aids for one session, not project history.
/data/models_backup_*/

# Play-by-play download cache, re-fetchable from nfl_data_py on demand.
/data/raw/pbp_advanced_*.parquet
/data/raw/pbp_team_advanced_*.parquet

# ESPN fantasy-league ("pool") data. This is the user's own team -- roster,
# lineup, matchups -- not NFL data, and the site is NFL projections only.
# docs/ is a published Pages directory, so anything the sync drops there would
# go public on the next commit. Patterns cover data outputs only; the ESPN
# source files and the *_lineup_weekly.csv backtest outputs stay tracked.
my_roster.json
**/my_roster*.json
docs/data/espn_*.json
data/espn_*.json
**/espn_cache/
.espn_cache/

# The canonical landing zone for pulled league data (config.ESPN_PRIVATE_DIR).
# Ignored by CONTENTS rather than by filename: the sync can write whatever it
# likes in here and stay covered, with no rule to update.
#
# `/dir/*` not `/dir/`, because git does not descend into an excluded
# directory -- with `/dir/` the .gitkeep negation below is silently dead and
# the folder vanishes from the tree entirely.
/data/espn_private/*
!/data/espn_private/.gitkeep
