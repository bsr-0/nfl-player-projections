{
  "groups": {
    "utilization": {
      "matchers": [
        "util",
        "target_share",
        "snap_share",
        "wopr",
        "expected_fp",
        "opportun",
        "touches"
      ],
      "numeric_strategy": "median",
      "fallback_value": 0.0,
      "warn_threshold": 0.05,
      "fail_threshold": 0.35,
      "exclude": [
        "snap_share_pct_roll3_mean",
        "snap_share_pct",
        "snap_share",
        "snap_count",
        "team_snaps",
        "snap_share_accel",
        "util_snap_share"
      ]
    },
    "matchup": {
      "matchers": [
        "opponent",
        "matchup",
        "spread",
        "game_total",
        "implied_team_total",
        "win_probability",
        "team_sos"
      ],
      "numeric_strategy": "median",
      "fallback_value": 0.0,
      "warn_threshold": 0.05,
      "fail_threshold": 0.4
    },
    "injury": {
      "matchers": [
        "injury",
        "is_injured",
        "prior_injuries",
        "suspended"
      ],
      "numeric_strategy": "value",
      "fallback_value": 0.0,
      "warn_threshold": 0.03,
      "fail_threshold": 0.3,
      "exclude": [
        "injury_score"
      ]
    },
    "rookie": {
      "matchers": [
        "rookie",
        "draft_",
        "combine",
        "athleticism"
      ],
      "numeric_strategy": "median",
      "fallback_value": 0.0,
      "warn_threshold": 0.05,
      "fail_threshold": 0.35
    },
    "pbp_advanced": {
      "matchers": [
        "epa",
        "wpa",
        "success_rate",
        "neutral_",
        "third_down",
        "short_yardage",
        "goal_line",
        "two_minute",
        "high_leverage"
      ],
      "numeric_strategy": "median",
      "fallback_value": 0.0,
      "warn_threshold": 0.05,
      "fail_threshold": 0.45
    },
    "ngs": {
      "matchers": [
        "ngs_"
      ],
      "numeric_strategy": "preserve",
      "fallback_value": 0.0,
      "warn_threshold": 0.9,
      "fail_threshold": 1.1
    }
  }
}
